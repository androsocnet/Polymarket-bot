[Unit]
Description=Polymarket BTC 15-minute INFRASTRUCTURE ingest-only service (%I)
Documentation=file:/opt/polymarket-btc/docs/linux-mvp-runbook.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=polymarket-btc
Group=polymarket-btc
WorkingDirectory=/opt/polymarket-btc
EnvironmentFile=/etc/polymarket-btc/infrastructure.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/polymarket-btc/src
Environment=MODE=PAPER_ONLY
ExecStartPre=!/opt/polymarket-btc/.venv/bin/python /opt/polymarket-btc/deploy/infrastructure-trial.py register --unit %n
ExecStart=/opt/polymarket-btc/.venv/bin/python -m polymarket_bot.linux_mvp ingest
RuntimeMaxSec=2040
RuntimeRandomizedExtraSec=0
Restart=no
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
UMask=0077
# Evidence stays root:root 0700; only root ExecStartPre can traverse/write it.
ReadWritePaths=/var/lib/polymarket-btc-infrastructure/data /var/lib/polymarket-btc-infrastructure/evidence
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryAccounting=true
MemoryMax=512M
CPUAccounting=true
CPUQuota=50%
TasksMax=64
LimitNOFILE=256

[Install]
# No WantedBy boot target: never starts at boot.
# Operator starts manually via the infrastructure runner.
