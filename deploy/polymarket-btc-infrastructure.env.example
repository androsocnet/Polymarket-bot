# INFRASTRUCTURE_ONLY service environment. Ingest-only; never starts trading.
# This file contains no authentication material.
# The service hard-refuses any MODE other than PAPER_ONLY.

MODE=PAPER_ONLY
MVP_BOT_ID=vps-infra-1
MVP_DB_PATH=/var/lib/polymarket-btc-infrastructure/data/infrastructure.sqlite
MVP_STATE_DIR=/var/lib/polymarket-btc-infrastructure/data/state

# Conservative defaults; change only with owner review.
# Matches paper defaults: $10 daily loss limit preserved.
MVP_INITIAL_CASH=100
MVP_MAX_ORDER=10
MVP_MAX_EXPOSURE=10
MVP_FEE_BPS=10
MVP_THRESHOLD=0.02
MVP_LOOKBACK=3
MVP_HOLDING_PERIOD=3
MVP_MAX_TRADES_PER_WINDOW=6
MVP_MAX_DAILY_LOSS=10
MVP_SAMPLE_SECONDS=2
MVP_POLL_SECONDS=2
MVP_BACKOFF_BASE_SECONDS=2
MVP_BACKOFF_MAX_SECONDS=30
MVP_MAX_SOURCE_AGE_SECONDS=5
MVP_MAX_CONSECUTIVE_ERRORS=5
