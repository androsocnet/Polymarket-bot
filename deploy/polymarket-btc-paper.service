[Unit]
Description=Polymarket BTC 15-minute PAPER_ONLY service
Documentation=file:/opt/polymarket-btc/docs/linux-mvp-runbook.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=polymarket
Group=polymarket
WorkingDirectory=/opt/polymarket-btc
EnvironmentFile=/etc/polymarket-btc/paper.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/polymarket-btc/src
Environment=MODE=PAPER_ONLY
ExecStart=/opt/polymarket-btc/.venv/bin/python -m polymarket_bot.linux_mvp run
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
StateDirectory=polymarket-btc
StateDirectoryMode=0750
ReadWritePaths=/var/lib/polymarket-btc
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryAccounting=true
MemoryMax=512M
CPUAccounting=true
CPUQuota=50%
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
