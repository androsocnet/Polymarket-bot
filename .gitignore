# Python environments and uv cache
.venv/
.uv-cache/

# Python generated files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test and analysis output
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Local settings and secrets
.env
.env.*
!.env.example

# Generated data and logs (retain folder placeholders)
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
*.log

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
